Options -MultiViews
RewriteEngine On

<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# Sitemap: redirect to edge function that generates the XML
RewriteRule ^sitemap\.xml$ https://hkpjbcovnrckihmxqytr.supabase.co/functions/v1/sitemap [R=302,L]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.holadieta\.mx [NC]
RewriteRule ^(.*)$ https://holadieta.mx/$1 [R=301,L]

# Redirect old plan pages to homepage
RewriteRule ^planes/?$ / [R=301,L]
RewriteRule ^planes/.+$ / [R=301,L]
RewriteRule ^plan_balance/?$ / [R=301,L]
RewriteRule ^plan_fitness/?$ / [R=301,L]
RewriteRule ^plan_lowcarb/?$ / [R=301,L]
RewriteRule ^about/?$ / [R=301,L]
RewriteRule ^acerca/?$ / [R=301,L]
RewriteRule ^bajar_de_peso/?$ / [R=301,L]
RewriteRule ^proteinas/?$ / [R=301,L]

# SPA fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
